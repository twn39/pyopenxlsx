from typing import Any, Iterator, List, Optional, Sequence, Tuple, Union

class StreamWriter:
    def __init__(self, native_writer: Any, workbook: Any = ...) -> None: ...
    def __enter__(self) -> StreamWriter: ...
    def __exit__(self, *args: Any) -> Any: ...
    @property
    def is_active(self) -> bool: ...
    @property
    def last_row(self) -> int: ...
    @property
    def max_column(self) -> int: ...
    def close(self) -> None: ...
    def flush(self) -> None: ...
    def set_column_width(
        self, min_col: int, max_col: int, width: float
    ) -> StreamWriter: ...
    def set_column_visible(
        self, min_col: int, max_col: int, visible: bool
    ) -> StreamWriter: ...
    def set_column_outline_level(self, col: int, level: int) -> StreamWriter: ...
    def set_column_style(
        self, min_col: int, max_col: int, style: int
    ) -> StreamWriter: ...
    def freeze_panes(
        self, top_left_or_cols: Union[str, int], rows: Optional[int] = ...
    ) -> StreamWriter: ...
    def append_row(self, values: Sequence[Any], row_opts: Any = ...) -> None: ...
    def append_rows(self, rows_iterable: Any) -> None: ...
    def set_row(
        self,
        row: int,
        start_col: int,
        values: Sequence[Any],
        row_opts: Any = ...,
    ) -> None: ...
    def set_row_ref(
        self, ref: str, values: Sequence[Any], row_opts: Any = ...
    ) -> None: ...
    def merge_cells(
        self, top_left: str, bottom_right: Optional[str] = ...
    ) -> StreamWriter: ...
    def auto_filter(self, range_str: str) -> StreamWriter: ...
    def add_hyperlink(
        self,
        cell_ref: str,
        target: str,
        tooltip: str = ...,
        is_external: bool = ...,
    ) -> StreamWriter: ...
    def insert_page_break(self, cell_ref: str) -> StreamWriter: ...
    @property
    def raw(self) -> Any: ...
    def is_stream_active(self) -> bool: ...
    def set_auto_filter(self, range_str: str) -> StreamWriter: ...

class StreamReader:
    def __init__(self, native_reader: Any) -> None: ...
    @property
    def raw(self) -> Any: ...
    def __iter__(self) -> StreamReader: ...
    def __next__(self) -> Any: ...
    def __enter__(self) -> StreamReader: ...
    def __exit__(self, *args: Any) -> Any: ...
    def has_next(self) -> bool: ...
    def next_row(self) -> List[Any]: ...
    def next_row_detailed(self) -> List[dict]: ...
    def next_row_sparse(self) -> List[dict]: ...
    def next_row_strings(self) -> List[str]: ...
    def current_row(self) -> int: ...
    @property
    def current_row_index(self) -> int: ...
    def current_row_opts(self) -> dict: ...
    @property
    def last_error(self) -> Optional[str]: ...
    @property
    def options(self) -> Any: ...
    def close(self) -> None: ...
    def iter_sparse(self) -> Iterator[List[Tuple[int, Any]]]: ...
